{
  "name": "aeon-learning-center-app",
  "productName": "Aeon Learning Center",
  "version": "1.0.0",
  "description": "Aeon Learning Center Word Processor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "npx eslint . --max-warnings 0",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "make": "electron-builder --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.1.0"
  },
  "build": {
    "appId": "com.aeonlearningcenter.app",
    "productName": "Aeon Learning Center",
    "extraResources": [
      {
        "from": "renderer",
        "to": "Aeon Learning Center"
      },
      {
        "from": "icon-linux.png",
        "to": "icon-linux.png"
      },
      {
        "from": "icon.icns",
        "to": "icon.icns"
      }
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon-linux.png",
      "category": "Office"
    }
  }
}
